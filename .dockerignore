# Build context for server-portable/Dockerfile and db/Dockerfile (the ob1-server
# and ob1-migrate images), both built from the REPO ROOT so they can reach
# db/config.mjs — the embedding contract the server and the migrator share — and
# releases.json.
#
# A root context means the whole repository is a candidate for upload, and this
# repo is mostly recipes, dashboards and docs that neither image touches.
# Without these rules the context is hundreds of megabytes of node_modules alone.
# server-portable/.dockerignore no longer applies: Docker reads the file at the
# context root, so its rules are folded in below.

# Never ship dependency trees — the image installs its own from bun.lock.
**/node_modules

# Everything outside the two directories the image actually needs.
recipes
dashboards
integrations
extensions
primitives
schemas
skills
docs
resources
changes
evals
server
supabase
.planning
.github
.git

# Tooling and tests, from every directory.
**/test-*.ts
**/test-*.mjs
**/*.test.ts
**/tsconfig.json
**/wrangler.toml
**/README.md
**/.dev.vars
**/.cf-out
**/*.log

# db/: the server image copies config.mjs, version.mjs and their types; the
# migrate image (db/Dockerfile, SMD-1860) copies migrate.ts, the flag scanner it
# imports (cli.ts, SMD-2134), its connection module (connect.ts, SMD-2302),
# migrations/, and login-role.ts, the orchestration runner's role step
# (SMD-2289). Both are built from this root, so both stay in the context; the
# tests, benches, workers and the tests' package do not.
db/*.ts
!db/migrate.ts
!db/cli.ts
!db/connect.ts
!db/login-role.ts
# The orchestration profile's import runner (deploy/orchestration/runner.Dockerfile,
# SMD-2212) runs the ingestion pipeline, so its import graph is let back in:
# these db/ modules (cli.ts and connect.ts above among them: every db/ script's
# flag scanner and connection module, and worker-bootstrap.ts, reembed's egress
# bootstrap, SMD-2303),
# and the two files outside db/ it reaches.
!db/ingest-*.ts
!db/reembed.ts
!db/weekly-digest.ts
!db/worker-bootstrap.ts
!db/lease.ts
!evals/linear-corpus.ts
# The authorization server's proof of concept (evals/auth/Dockerfile, SMD-2285)
# builds from this root too, so its image holds the deploy's modules beside its
# own (deploy/ is in the context already).
!evals/auth/*.ts
!evals/auth/package.json
!evals/auth/bun.lock
db/*.sh
db/package.json
db/bun.lock

# Local environment and editor state.
.env
**/.env
# The exports an operator drops for the import runner: private data, mounted
# read-only into the runner at run time and never part of any image.
deploy/imports
.DS_Store
.vscode
.idea

# Parallel-agent worktrees (Claude Code creates these under .claude/worktrees):
# tens of GB of checkouts and doc assets (e.g. .mp4 walkthroughs) the image never
# uses. Without this the root context balloons and OOMs the build daemon (SMD-2177).
.claude

# Local scratch that is not part of any image.
*.zip
proposal
