[
  {
    "id": "ob1brainCapture1",
    "name": "OB1 brain — capture key",
    "optional": true,
    "brainScope": "capture",
    "type": "httpHeaderAuth",
    "data": {
      "name": "x-brain-key",
      "value": "${N8N_BRAIN_CAPTURE_KEY}"
    }
  },
  {
    "id": "ob1inboundMcp001",
    "name": "OB1 inbound — MCP clients",
    "type": "httpHeaderAuth",
    "data": {
      "name": "x-n8n-key",
      "value": "${N8N_MCP_KEY}"
    }
  },
  {
    "id": "ob1inboundRun001",
    "name": "OB1 inbound — on-demand runs",
    "type": "httpHeaderAuth",
    "data": {
      "name": "x-n8n-run-key",
      "value": "${N8N_WEBHOOK_KEY}"
    }
  },
  {
    "id": "ob1runnerKey0001",
    "name": "OB1 runner — imports",
    "type": "httpHeaderAuth",
    "data": {
      "name": "x-runner-key",
      "value": "${OB1_RUNNER_KEY}",
      "allowedHttpRequestDomains": "domains",
      "allowedDomains": "orchestration-runner"
    }
  },
  {
    "id": "ob1linearAct0001",
    "name": "OB1 vendor — Linear (act tool)",
    "optional": true,
    "type": "linearApi",
    "data": {
      "apiKey": "${N8N_LINEAR_API_KEY}",
      "allowedHttpRequestDomains": "domains",
      "allowedDomains": "api.linear.app"
    }
  }
]
