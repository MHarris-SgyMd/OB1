# Copy to deploy/.env (gitignored) and fill in.
#
# Replaces `supabase secrets set` — the same four values, now ordinary environment
# variables that your platform's secret store supplies.

# Database password for the bundled Postgres.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# The single shared key clients present, as a header or ?key= in the URL.
# This is the ONLY thing protecting the endpoint — see FORK.md, issue #216.
#   openssl rand -hex 32
MCP_ACCESS_KEY=

# Embeddings and metadata extraction.
OPENROUTER_API_KEY=

# Optional.
# OPEN_BRAIN_CITATION_BASE_URL=https://your-dashboard.example/thoughts
# OB1_PG_POOL=10
# SERVER_PORT=8000
# POSTGRES_PORT=5432
