# Open Brain — ChatGPT Import
# Copy this file to .env and fill in your values.
# Then: export $(cat .env | xargs)

# Supabase (from your Open Brain setup — Credential Tracker)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenRouter (for LLM summarization and embedding generation)
# If you rotate this key on openrouter.ai, update it here AND in deploy/.env,
# then restart the server (docs/03-faq.md, "API Key Rotation").
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: Custom ingest endpoint (use with --ingest-endpoint flag)
# INGEST_URL=https://your-host/   # the Slack capture server's URL (integrations/slack-capture)
# INGEST_KEY=your-ingest-key-here

# Optional: fills chatgpt_conversations.user_id, a plain nullable uuid on this fork (SMD-1810).
# Your DEFAULT_USER_ID, or leave blank for a single-user brain.
# USER_ID=your-user-uuid-here

# --store-conversations flag
# Stores conversation-level pyramid summaries in the chatgpt_conversations table.
# You MUST run schema.sql in your Supabase SQL Editor before using this flag.
# See: recipes/chatgpt-conversation-import/schema.sql
