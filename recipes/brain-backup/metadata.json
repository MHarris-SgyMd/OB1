  "category": "recipes",
  "author": {
    "name": "Alan Shurafa",
    "github": "alanshurafa"
  },
  "version": "1.0.0",
  "requires": {
    "open_brain": true,
    "services": [],
    "tools": ["Bun 1.4+"],
    "env": {
      "required": ["SUPABASE_URL"],
      "optional": ["FETCH_TIMEOUT_MS"],
      "ignored": ["SUPABASE_SERVICE_ROLE_KEY"]
    }
  },
  "tags": ["backup", "export", "data-safety"],
  "difficulty": "beginner",
  "estimated_time": "10 minutes"
}
