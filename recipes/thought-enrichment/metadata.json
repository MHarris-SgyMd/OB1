{
  "name": "Thought Enrichment Pipeline",
  "description": "Retroactively classifies existing thoughts with type, importance, sensitivity, topics, tags, and more using LLM-based enrichment and regex-based sensitivity detection.",
  "category": "recipes",
  "author": {
    "name": "Alan Shurafa",
    "github": "alanshurafa"
  },
  "version": "1.0.0",
  "requires": {
    "open_brain": true,
    "services": ["OpenRouter API (enrich-thoughts.mjs only; or any OpenAI-compatible endpoint, a local one included)", "Anthropic API (enrich-thoughts.mjs, --provider anthropic)"],
    "tools": ["Bun 1.4+"],
    "env": {
      "required": ["SUPABASE_URL"],
      "optional": ["OPENROUTER_API_KEY", "OPENROUTER_BASE_URL", "OPENROUTER_CLASSIFIER_MODEL", "ANTHROPIC_API_KEY", "ANTHROPIC_CLASSIFIER_MODEL", "ENRICH_PROVIDER", "ENRICH_MAX_CALLS", "ENRICH_STATE_DIR", "FETCH_TIMEOUT_MS", "DEBUG"],
      "ignored": ["SUPABASE_SERVICE_ROLE_KEY"]
    }
  },
  "tags": ["enrichment", "classification", "backfill", "metadata", "llm", "openrouter", "anthropic"],
  "difficulty": "intermediate",
  "estimated_time": "30 minutes"
}
