# Copy this file to `.env.local` for local development.
# SvelteKit only picks up env changes after restarting `bun run dev`.
#
# Both values are server-only: nothing here reaches the browser bundle. The
# access key is NOT configured here — each visitor pastes their own at /signin
# (a read key browses and searches; a write key can capture too) and the
# dashboard forwards it, so revoking the key in the server's MCP_ACCESS_KEYS
# ends the session.

# Where your Open Brain server answers MCP. The compose stack (SETUP.md)
# publishes it on the loopback at this address; any URL that speaks the
# protocol works (a container on a cluster, a Cloudflare Worker).
MCP_URL=http://127.0.0.1:8000/

# 32+ characters; seals the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=
