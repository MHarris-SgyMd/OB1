node_modules/
.DS_Store
.planning/
supabase/

# Maintainer-local overlays (not part of upstream contribution contract)
.local/
.agent/
.claude.json

# Python caches
__pycache__/
*.pyc

# Credentials & runtime state
.env
.env.local
.env.*.local
credentials.json
token.json
# An agent's work-claim tokens, one file per claim at a worktree's root
# (AGENTS.md, "Claim your work"; SMD-3602): each proves its claim under the key.
# Unanchored and without a slash, so one made in a subdirectory, or a symlink
# by the name, is ignored too (review pass 1).
.work-claims
gmail-sync-log.json
sync-log.json

# The edge proxy's registry and the route table rendered from it (SMD-2876):
# the operator's, written by deploy/edge/edge.ts.
deploy/edge/brains.local.yaml
deploy/edge/dynamic/
# The federated coordinator's registry (SMD-3379 PR 3a): the operator's, read by
# deploy/federated/federated.ts.
deploy/federated/federation.local.yaml

# Build artifacts
deno.lock
docs/assets/agent-memory/promotional/generated-backgrounds/**/result.json
integrations/openclaw-agent-memory/dist/

# Evaluation corpora built from real data — Linear issues, exported notes, anything
# pointed at by OB1_EVAL_CORPUS. The harnesses default to /tmp for this reason, but
# it is an easy convenience to drop one in the repo and this is a PUBLIC repository.
# The synthetic corpus (evals/corpus.ts) is committed deliberately; these are not.
*-corpus.json
evals/corpus-*.json
evals/*.local.json

# The authorization-server POC's throwaway TLS certificate and key (SMD-2285),
# written by `bun evals/eval-auth.ts --up`.
evals/auth/.poc/

# Recipe run output — full email and memory text, never to be committed.
# gmail-smart-pull writes its packs and its Gmail state under
# recipes/gmail-smart-pull/data/ (the OAuth token lives beside the script, in
# its own ignored file); the atomizer reads and writes data/atomic-memories/
# relative to the CURRENT DIRECTORY, so from the repo root that is
# /data/atomic-memories/. scripts/check-consistency.ts skips ignored
# files, so a pulled email that happens to contain a flagged string cannot fail
# the shell-hazard check on the machine that pulled it.
recipes/*/data/
/data/atomic-memories/

# db/backup.ts's default output (SMD-3318): ./backup under the working
# directory — the repo root's or db/'s when run from a checkout, or
# recipes/brain-backup's for a cron job kept where the recipe's script ran.
# Every thought's text — never to be committed.
/backup/
/db/backup/
/recipes/brain-backup/backup/
