{
  "name": "ob1-evals",
  "private": true,
  "type": "module",
  "dependencies": {
    "@lancedb/lancedb": "0.38.0",
    "apache-arrow": "^18.1.0"
  },
  "scripts": {
    "retrieval": "bun eval-retrieval.ts nomic-embed-text embeddinggemma bge-m3 snowflake-arctic-embed2 mxbai-embed-large granite-embedding all-minilm",
    "extraction": "bun eval-extraction.ts llama3.2 qwen2.5:7b phi4-mini gemma3:4b",
    "keyword": "../db/with-postgres.sh bun eval-keyword.ts qwen3-embedding:4b",
    "contextual": "bun eval-contextual.ts",
    "filtered": "../db/with-postgres.sh bun eval-filtered.ts",
    "entities": "../db/with-postgres.sh bun eval-entities.ts qwen2.5:7b",
    "entities:corpus": "../db/with-postgres.sh bun eval-entities.ts --corpus",
    "graphrag": "../db/with-postgres.sh bun eval-graphrag.ts",
    "graph-scale": "OB1_EVAL_EMBED=syn@64 OB1_GRAPH_KPRIME=10,100,1000 OB1_GRAPH_HOPS=1,2 OB1_PG_SHM=3g ../db/with-postgres.sh bun eval-graphrag.ts --scale 1000000",
    "hybrid": "../db/with-postgres.sh bun eval-hybrid.ts",
    "recency": "../db/with-postgres.sh bun eval-recency.ts",
    "store-compare": "bun store-compare.ts",
    "store-scale": "bun store-scale.ts",
    "store-composed": "bun store-composed.ts",
    "longmemeval": "bun eval-longmemeval.ts",
    "quant": "../db/with-postgres.sh bun eval-quant.ts",
    "export-queries": "bun export-queries.ts",
    "replay": "bun eval-replay.ts",
    "build-replay-fixture": "bun build-replay-fixture.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "5.9.3"
  }
