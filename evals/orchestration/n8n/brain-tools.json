{
  "name": "OB1 — remember and act, as MCP tools",
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "5c1d2e3f-0001-4b2a-8e00-000000000001",
      "name": "MCP Server Trigger",
      "type": "@n8n/n8n-nodes-langchain.mcpTrigger",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "5c1d2e3f-aaaa-4b2a-8e00-000000000b1a",
      "parameters": {
        "authentication": "headerAuth",
        "path": "ob1"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "ob1inboundMcp001",
          "name": "OB1 inbound — MCP clients"
        }
      }
    },
    {
      "id": "5c1d2e3f-0002-4b2a-8e00-000000000002",
      "name": "brain_search_thoughts",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        -200,
        220
      ],
      "parameters": {
        "toolDescription": "Search the Open Brain for thoughts about a topic; returns the best matches with their text.",
        "method": "POST",
        "url": "http://api:8000/v1/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query: $fromAI('query', 'What to search for', 'string'), limit: $fromAI('limit', 'How many thoughts to return, 1 to 50', 'number', 3) }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "ob1read000000001",
          "name": "Brain — read key"
        }
      }
    },
    {
      "id": "5c1d2e3f-0003-4b2a-8e00-000000000003",
      "name": "linear_issue",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        200,
        220
      ],
      "parameters": {
        "toolDescription": "Look up a Linear issue's live state — title, state, assignee, last update — by its identifier, e.g. SMD-1863.",
        "method": "POST",
        "url": "https://api.linear.app/graphql",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "linearApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query: 'query($id: String!) { issue(id: $id) { identifier title url updatedAt state { name } assignee { name } } }', variables: { id: $fromAI('identifier', 'A Linear issue identifier such as SMD-1863', 'string') } }) }}",
        "options": {}
      },
      "credentials": {
        "linearApi": {
          "id": "ob1linear0000001",
          "name": "Linear (read)"
        }
      }
    }
  ],
  "connections": {
    "linear_issue": {
      "ai_tool": [
        [
          {
            "node": "MCP Server Trigger",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "brain_search_thoughts": {
      "ai_tool": [
        [
          {
            "node": "MCP Server Trigger",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    }
  }
}
