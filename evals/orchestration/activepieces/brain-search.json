{
  "displayName": "OB1 — brain_search (MCP tool)",
  "schemaVersion": null,
  "notes": null,
  "trigger": {
    "name": "trigger",
    "valid": true,
    "displayName": "MCP tool: brain_search",
    "type": "PIECE_TRIGGER",
    "settings": {
      "pieceName": "@activepieces/piece-mcp",
      "pieceVersion": "~0.0.21",
      "triggerName": "mcp_tool",
      "input": {
        "toolName": "brain_search",
        "toolDescription": "Search the Open Brain for thoughts about a topic; returns the best matches with their text.",
        "inputSchema": [{ "name": "query", "type": "Text", "required": true, "description": "What to search for" }],
        "returnsResponse": true
      },
      "propertySettings": {}
    },
    "nextAction": {
      "name": "step_1",
      "valid": true,
      "displayName": "Search the brain",
      "type": "PIECE",
      "settings": {
        "pieceName": "@activepieces/piece-http",
        "pieceVersion": "~0.13.0",
        "actionName": "send_request",
        "input": {
          "method": "POST",
          "url": "http://api:8000/v1/search",
          "headers": { "x-brain-key": "__OB1_BRAIN_READ_KEY__", "content-type": "application/json" },
          "queryParams": {},
          "authType": "NONE",
          "authFields": {},
          "body_type": "json",
          "body": { "data": { "query": "{{trigger.query}}", "limit": 3 } },
          "response_is_binary": false,
          "use_proxy": false,
          "timeout": 120,
          "followRedirects": false,
          "failureMode": "continue_none"
        },
        "propertySettings": {},
        "errorHandlingOptions": { "continueOnFailure": { "value": false }, "retryOnFailure": { "value": false } }
      },
      "nextAction": {
        "name": "step_2",
        "valid": true,
        "displayName": "Reply",
        "type": "PIECE",
        "settings": {
          "pieceName": "@activepieces/piece-mcp",
          "pieceVersion": "~0.0.21",
          "actionName": "reply_to_mcp_client",
          "input": { "mode": "simple", "response": { "response": { "result": "{{step_1.body}}" } }, "respond": "stop" },
          "propertySettings": {},
          "errorHandlingOptions": { "continueOnFailure": { "value": false }, "retryOnFailure": { "value": false } }
        }
      }
    }
  }
}
