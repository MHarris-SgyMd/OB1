# These are set automatically by Supabase when you deploy an Edge Function.
# You only need to set the access keys manually.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# name:scope:sha256 entries, comma-separated; scope read or write. Mint one with
# `bun keygen.ts --name laptop --scope write` in server-portable/ — the hash is
# stored, never the key.
MCP_ACCESS_KEYS=laptop:write:<sha256 of the key>
# The older single raw key still works, with write scope; prefer MCP_ACCESS_KEYS.
# MCP_ACCESS_KEY=your-mcp-access-key
# The shared server (shared-server.ts) reads its own pair, same shapes.
MCP_HOUSEHOLD_ACCESS_KEYS=spouse:read:<sha256 of the key>
# MCP_HOUSEHOLD_ACCESS_KEY=your-household-access-key
SUPABASE_HOUSEHOLD_KEY=household-scoped-api-key
