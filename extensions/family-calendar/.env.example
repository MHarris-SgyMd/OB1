# The server runs under Bun against your Postgres (primitives/deploy-remote-mcp).
# SUPABASE_URL is the connection string — the SQL shim keeps supabase-js's
# variable name; the service-role key may be left unset (the shim ignores it).

SUPABASE_URL=postgres://user:password@host:5432/openbrain
SUPABASE_SERVICE_ROLE_KEY=
# name:scope:sha256 entries, comma-separated; scope read or write. Mint one with
# `bun keygen.ts --name laptop --scope write` in server-portable/ — the hash is
# stored, never the key.
MCP_ACCESS_KEYS=laptop:write:<sha256 of the key>
# The older single raw key still works, with write scope; prefer MCP_ACCESS_KEYS.
# MCP_ACCESS_KEY=your-mcp-access-key
